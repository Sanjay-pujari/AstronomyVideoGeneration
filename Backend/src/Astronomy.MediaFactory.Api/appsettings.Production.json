{
  "VisualIntelligence": {
    "Enabled": false,
    "WriteDiagnostics": false,
    "DiagnosticsOutputPath": "",
    "DefaultProvider": "unknown",
    "ObservationMode": true,
    "UseVisualCreativeDirector": false,
    "UseCDL": false,
    "UseCreativeDirectionContract": false,
    "UsePromptComposerV2": false,
    "UseProviderProfiles": false,
    "UseQualityScoring": false,
    "UseQualityScoringBlocking": false,
    "UseExperimentalRenderingRules": false
  },
  "SubtitleTtsOptions": {
    "TtsMode": "SceneLevel",
    "SubtitleMaxWordsPerCue": 8,
    "SubtitleMaxLines": 2,
    "SubtitleMaxCharsPerLine": 42,
    "SubtitleMinCueDurationMs": 1200,
    "SubtitleMaxCueDurationMs": 4200,
    "SentenceBreakPauseMs": 80,
    "CueGapMs": 0
