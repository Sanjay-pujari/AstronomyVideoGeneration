  "ContentDuration": {
    "DailySkyGuideMinutes": 6,
    "SpecialEventGuideMinutes": 8,
    "YouTubeShortSeconds": 50,
    "InstagramReelSeconds": 40,
    "FacebookReelSeconds": 50,
    "AllowDynamicOptimization": true
  },
  "ContentExpansion": {
    "Enabled": true,
    "TargetDailyGuideMinutes": 6,
    "TargetSpecialEventMinutes": 8,
    "MinObjectsPerGuide": 3,
    "MaxObjectsPerGuide": 6,
    "AllowMoonSegment": true,
    "AllowConstellations": true,
    "AllowBrightStars": true,
    "AllowDeepSkyObjects": true,
    "AllowObservationTips": true,
    "MinimumVisibilityScore": 0.55
  },
  "ThumbnailFonts": {
    "DefaultEnglishFont": "assets/fonts/Montserrat-ExtraBold.ttf",
    "HindiFont": "assets/fonts/NotoSansDevanagari-Bold.ttf"
  },
  "ThumbnailGeneration": {
    "PreferredAssetFileNames": [
      "hero-transparent.png",
      "hero.png",
      "cinematic.png",
      "closeup.png"
    ],
    "PreferPngAssets": true,
    "PreferAssetPackImages": true,
    "DeepSpaceHeroPenalty": 0.45
  },
  "CelestialAssetPack": {
    "Enabled": true,
    "SourceSheetPath": "assets/celestial/source/celestial-object-sheet.png",
    "SheetMapPath": "assets/celestial/source/celestial-object-sheet-map.json",
    "OutputRootPath": "assets/celestial",
    "OverwriteExisting": false
  },
  "WeeklySkyForecast": {
    "AICinematicAssets": {
      "Enabled": true,
      "MaxAssetsPerRun": 3,
      "MaxGenerationSeconds": 240,
      "GenerationTimeoutSeconds": 240,
      "SingleImageTimeoutSeconds": 180,
      "ContinueOnFailure": true,
      "SkipExistingValidAssets": true,
      "ResumeExistingRunAssets": true
    },
    "AssetExpansion": {
      "Mode": "ExecuteExpandedScenes",
      "MaxExpandedScenesPerRun": 1,
      "MaxFramesPerExpandedScene": 1,
      "ExpandedExecutionTimeoutSeconds": 300,
      "ContinueOnFailure": true
    }
  },
  "ProductionPipeline": {
    "StaleRunningRecoveryEnabled": true,
    "StaleRunningThresholdMinutes": 30
  },
  "VideoAssembly": {
    "Subtitles": {
      "Enabled": true,
      "BurnIn": false,
      "GenerateSrt": true,
      "GenerateAss": true
    }
